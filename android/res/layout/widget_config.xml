<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#102033">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="小工具設定"
            android:textColor="#F4F7FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/weather_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="顯示香港天氣"
            android:textColor="#F4F7FF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="透明度"
            android:textColor="#F4F7FF" />

        <SeekBar
            android:id="@+id/alpha_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:progress="35" />

        <TextView
            android:id="@+id/alpha_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="65%"
            android:textColor="#C9D4EA" />

        <Button
            android:id="@+id/pick_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="轉換背景" />

        <ImageView
            android:id="@+id/bg_preview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#071426"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="喺圖上拖拉同雙指縮放，再撳套用裁切"
            android:textColor="#C9D4EA" />

        <Button
            android:id="@+id/apply_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="套用裁切" />

        <Button
            android:id="@+id/clear_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="改返純色背景" />

        <Button
            android:id="@+id/save_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="完成" />
    </LinearLayout>
</ScrollView>
